#!/usr/bin/env bash
#
#   把 %Y-%m-%d_%H-%M-%S.flv 分片（确认已停止写入后）用 stream copy
#   转封装成 .ts，并归档到：  <DST_ROOT>/%Y-%m/%d_%H-%M-%S.ts
#
# 处理条件（全部满足才转）：
#   1) 本次运行与上次“处理”至少相隔 MIN_INTERVAL 秒；
#   2) 某个 .flv 的大小与上一次采样完全相同（说明 nginx 已写完、分片完整）。
#
set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
: "${HOME:=/home/ken}"

# ==================== 可调参数（可用环境变量覆盖）====================
SRC_DIR="${SRC_DIR:-/home/router_shared/Videos/Captures/OBS}"   # 源目录
DST_ROOT="${DST_ROOT:-/home/router_shared/Videos/Captures/copied}"     # 归档根目录
MIN_INTERVAL="${MIN_INTERVAL:-30}"        # 两次处理的秒数下限
STATE_DIR="${STATE_DIR:-$HOME/.local/state/flv2ts}"   # 状态/锁/日志
FFMPEG="${FFMPEG:-ffmpeg}"
KEEP_SOURCE="${KEEP_SOURCE:-0}"           # 1=转好后保留原 .flv；0=删除原 .flv
DRY_RUN="${DRY_RUN:-0}"                   # 1=只打印不落盘（自测用）
# =================================================================

LOCK_FILE="$STATE_DIR/flv2ts.lock"
LOG_FILE="$STATE_DIR/flv2ts.log"

mkdir -p "$STATE_DIR/size"

log() { printf '%s [%s] %s\n' "$(date '+%F %T')" "$$" "$*"; }

# ---- 防重入 ----
exec 9>"$LOCK_FILE"
flock -n 9 || { log "上一轮仍在运行，退出"; exit 0; }

# ---- 1) 间隔检查：与上次处理至少相隔 MIN_INTERVAL 秒 ----
now=$(date +%s)
last=$(cat "$STATE_DIR/last_run" 2>/dev/null || echo 0)
if [ "${last:-0}" -gt 0 ] && [ $(( now - last )) -lt "$MIN_INTERVAL" ]; then
    log "距上次处理仅 $(( now - last ))s (<${MIN_INTERVAL}s)，跳过"
    exit 0
fi
printf '%s\n' "$now" > "$STATE_DIR/last_run"

# ---- 由文件名解析归档路径：%Y-%m/%d_%H-%M-%S.ts ----
resolve_dest() {
    local base="$1" stem y mo d h mi s
    stem="${base%.flv}"
    if [[ $stem =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})_([0-9]{2})-([0-9]{2})-([0-9]{2})$ ]]; then
        y=${BASH_REMATCH[1]}; mo=${BASH_REMATCH[2]}; d=${BASH_REMATCH[3]}
        h=${BASH_REMATCH[4]}; mi=${BASH_REMATCH[5]}; s=${BASH_REMATCH[6]}
    elif [[ $stem =~ ^([0-9]{2})-([0-9]{2})_([0-9]{2})-([0-9]{2})-([0-9]{2})$ ]]; then
        # 旧命名 %m-%d_%H-%M-%S，年份取文件 mtime
        mo=${BASH_REMATCH[1]}; d=${BASH_REMATCH[2]}
        h=${BASH_REMATCH[3]}; mi=${BASH_REMATCH[4]}; s=${BASH_REMATCH[5]}
        y=$(date -r "$SRC_DIR/$base" +%Y 2>/dev/null) || return 1
    else
        return 1
    fi
    printf '%s/%s-%s/%s_%s-%s-%s.ts\n' "$DST_ROOT" "$y" "$mo" "$d" "$h" "$mi" "$s"
}

shopt -s nullglob
done_count=0

# ---- 2) 遍历源目录 ----
for src in "$SRC_DIR"/*.flv; do
    base=$(basename "$src")
    cur=$(stat -c %s "$src" 2>/dev/null) || continue

    prevfile="$STATE_DIR/size/$base"
    prev=$(cat "$prevfile" 2>/dev/null || echo "")

    # 大小有变 => 仍在写入（或首次采样），记录本次大小，下一轮再比
    if [ "$cur" != "$prev" ]; then
        printf '%s\n' "$cur" > "$prevfile"
        log "观察 $base size=$cur (上次=${prev:-无})"
        continue
    fi

    # 大小与上次一致 => 认为已写完
    if ! dst=$(resolve_dest "$base"); then
        log "跳过 $base（文件名不符合时间格式）"
        continue
    fi

    if [ -e "$dst" ]; then
        log "目标已存在 $dst，清理状态"
        rm -f "$prevfile"
        if [ "$KEEP_SOURCE" = 0 ] && [ "$DRY_RUN" = 0 ]; then rm -f "$src"; fi
        continue
    fi

    if [ "$DRY_RUN" = 1 ]; then
        log "DRY   $base  ->  $dst"
        continue
    fi

    # ---- 3) 转封装：-c copy，原子落盘 ----
    mkdir -p "$(dirname "$dst")"
    tmp="$dst.part.$$"
    if "$FFMPEG" -hide_banner -loglevel error -y -i "$src" -c copy -f mpegts "$tmp"; then
        mv -f "$tmp" "$dst"
        rm -f "$prevfile"
        if [ "$KEEP_SOURCE" = 0 ]; then rm -f "$src"; fi
        done_count=$((done_count+1))
        log "完成 $base  ->  $dst"
    else
        rc=$?
        rm -f "$tmp"
        log "失败 转封装 $base (rc=$rc)，保留源文件"
    fi
done

# ---- 清理已不存在源对应的状态文件 ----
for st in "$STATE_DIR/size"/*; do
    [ -e "$st" ] || continue
    b=$(basename "$st")
    [ -e "$SRC_DIR/$b" ] || rm -f "$st"
done

[ "$done_count" -gt 0 ] && log "本轮归档 $done_count 个文件"
exit 0
